# Chaves de API para os provedores de Inteligência Artificial Real (LLM)
# Nunca coloque suas chaves reais aqui neste arquivo de exemplo!
GEMINI_API_KEY=
OPENROUTER_API_KEY=
DEEPSEEK_API_KEY=

# Interface de escuta. O padrão é local; defina explicitamente para expor a aplicação.
# O endpoint /api/llm-action continua aceitando apenas chamadas do loopback.
# LLM_PROXY_HOST=127.0.0.1

# Rate limit e timeout das rotas de LLM.
# LLM_RATE_LIMIT_MAX=60
# LLM_RATE_LIMIT_WINDOW_MS=60000
# LLM_REQUEST_TIMEOUT_MS=30000

# Modelos pagos adicionais, no formato provider:model, separados por vírgulas.
# LLM_ALLOWED_PAID_MODELS=openrouter:openai/gpt-4o
